{
  "all": true,
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "server/**/*.test.ts",
    "server/index.ts",
    "server/verify-postgres.ts"
  ],
  "reporter": [
    "text",
    "html",
    "lcov",
    "json-summary"
  ],
  "reports-dir": "coverage",
  "exclude-after-remap": true,
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "branches": 90,
  "functions": 80
}
